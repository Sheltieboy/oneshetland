{
  "name": "oneshetland-fetch",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "node scripts/test-lanes.mjs offline",
    "typecheck": "tsc --noEmit",
    "test:isolated": "node scripts/isolated-pg.mjs",
    "test:all": "npm test && npm run test:isolated",
    "test:quarantined": "node scripts/test-lanes.mjs quarantined",
    "test:integration:production-readonly": "node scripts/test-lanes.mjs production-readonly",
    "check:migrations": "node scripts/check-migration-history.mjs",
    "check:migrations:offline": "node scripts/check-migration-history.mjs --snapshot",
    "db:push:guarded": "node scripts/check-migration-history.mjs && supabase db push",
    "check:function-deploy": "node scripts/check-function-deploy.mjs",
    "check:function-manifest": "node scripts/function-manifest.mjs verify",
    "test:replay": "node scripts/migration-replay/replay.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/fraunces": "^0.4.1",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.6.0",
    "@stripe/stripe-react-native": "0.63.0",
    "@supabase/supabase-js": "^2.45.0",
    "expo": "~55.0.26",
    "expo-audio": "~55.0.14",
    "expo-camera": "~55.0.19",
    "expo-constants": "~55.0.16",
    "expo-crypto": "~55.0.18",
    "expo-dev-client": "~55.0.35",
    "expo-device": "~55.0.17",
    "expo-font": "~55.0.8",
    "expo-haptics": "~55.0.14",
    "expo-image-manipulator": "~55.0.21",
    "expo-image-picker": "~55.0.20",
    "expo-linking": "~55.0.15",
    "expo-location": "~55.1.10",
    "expo-notifications": "~55.0.23",
    "expo-router": "~55.0.16",
    "expo-secure-store": "~55.0.14",
    "expo-splash-screen": "~55.0.21",
    "expo-status-bar": "~55.0.6",
    "expo-updates": "~55.0.26",
    "expo-video": "~55.0.17",
    "expo-web-browser": "~55.0.20",
    "react": "19.2.0",
    "react-native": "0.83.6",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-google-places-autocomplete": "^2.6.4",
    "react-native-image-colors": "^2.6.0",
    "react-native-maps": "1.27.2",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-url-polyfill": "^2.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.2.10",
    "react-native-svg-transformer": "^1.5.3",
    "typescript": "^5.3.0"
  }
}
