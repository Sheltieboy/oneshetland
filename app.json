{
  "expo": {
    "name": "OneShetland",
    "slug": "oneshetland-delivers",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "jsEngine": "jsc",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#032F4C"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.oneshetland.app",
      "buildNumber": "3",
      "icon": "./assets/icon.png",
      "associatedDomains": [
        "applinks:oneshetland.com"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "OneShetland uses your camera to take photos of delivered items.",
        "NSPhotoLibraryUsageDescription": "OneShetland uses your photo library to attach images to deliveries.",
        "NSLocationWhenInUseUsageDescription": "OneShetland uses your location to verify you're at a business when you tap a Local NFC tile, and to match you with nearby drivers.",
        "NSMicrophoneUsageDescription": "OneShetland may use your microphone for video proof of delivery."
      }
    },
    "android": {
      "package": "com.oneshetland.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#032F4C"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "oneshetland.com",
              "pathPrefix": "/t/"
            },
            {
              "scheme": "https",
              "host": "oneshetland.com",
              "pathPrefix": "/g/"
            },
            {
              "scheme": "https",
              "host": "oneshetland.com",
              "pathPrefix": "/give/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Allow OneShetland to use Face ID to secure your account."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#032F4C",
          "sounds": []
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-web-browser",
      "expo-video"
    ],
    "scheme": "oneshetland-fetch",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "505d7724-8b86-493d-973e-45c44011157f"
      }
    },
    "owner": "darrenfullerton",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/505d7724-8b86-493d-973e-45c44011157f"
    }
  }
}
