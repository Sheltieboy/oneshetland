{
  "expo": {
    "name": "OneShetland Fetch",
    "slug": "oneshetland-delivers",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#032F4C"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.oneshetland.app",
      "icon": "./assets/icon.png",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "OneShetland Fetch uses your camera to take photos of delivered items.",
        "NSPhotoLibraryUsageDescription": "OneShetland Fetch uses your photo library to attach images to deliveries.",
        "NSLocationWhenInUseUsageDescription": "OneShetland Fetch uses your location to help match you with nearby drivers.",
        "NSMicrophoneUsageDescription": "OneShetland Fetch may use your microphone for video proof of delivery."
      }
    },
    "android": {
      "package": "com.oneshetland.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#032F4C"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Allow OneShetland Fetch to use Face ID to secure your account."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#032F4C",
          "sounds": []
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-web-browser"
    ],
    "scheme": "oneshetland-fetch",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "505d7724-8b86-493d-973e-45c44011157f"
      }
    },
    "owner": "darrenfullerton"
  }
}
