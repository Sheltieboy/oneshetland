# OneShetland Delivers — Environment Variables
# Copy this file to .env and fill in your Supabase credentials.
# Never commit .env to version control.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Tide times on the Shetland Today card — ADMIRALTY UK Tidal API (free "Discovery"
# tier). Register at https://admiraltyapi.portal.azure-api.net/ → subscribe to
# "UK Tidal API – Discovery" → copy your Primary key from Profile.
# Optional: without it, the weather card simply hides the tide strip.
EXPO_PUBLIC_ADMIRALTY_KEY=your-admiralty-primary-key-here
