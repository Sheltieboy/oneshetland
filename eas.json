{
  "cli": {
    "version": ">= 19.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "preview"
    },
    "development-simulator": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": { "simulator": true }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "channel": "preview",
      "env": {
        "APP_VARIANT": "preview"
      }
    },
    "preview-demo": {
      "distribution": "internal",
      "environment": "development",
      "channel": "preview-demo",
      "env": {
        "APP_VARIANT": "preview-demo",
        "EXPO_PUBLIC_SUPABASE_URL": "http://Darrens-MacBook-Pro.local:54790",
        "EXPO_PUBLIC_SUPABASE_ANON_KEY": "demo-backend-ignores-this-key"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "environment": "production"
    }
  },
  "submit": {
    "production": {}
  }
}
